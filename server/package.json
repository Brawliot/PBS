{
  "name": "pbs-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env server.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:e2e": "node test/e2e/build-my-plan.mjs && tsx test/e2e/plan-decisions.e2e.ts && node test/e2e/loader.e2e.mjs",
    "start": "tsx --env-file=.env server.ts",
    "typecheck": "tsc",
    "migrate": "tsx --env-file=.env db/migrate-cli.ts",
    "perf": "tsx test/perf/perf.ts",
    "agents:real-plan": "tsx --env-file=.env scripts/real-plan-agent.ts",
    "agents:eval": "tsx --env-file=.env scripts/agents-eval.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
